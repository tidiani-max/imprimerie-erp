{
  "name": "imprimerie-erp",
  "private": true,
  "version": "1.0.0",
  "description": "ERP/CRM pour imprimerie : ventes, clients, stock, dépenses et caisse",
  "author": "Imprimerie ERP",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "server": "node server/src/index.js",
    "server:dev": "node --watch server/src/index.js",
    "test:api": "node server/test/smoke.test.js && node server/test/accounts.test.js && node server/test/business.test.js",
    "desktop:dev": "concurrently -k -n vite,api,electron -c blue,green,magenta \"vite\" \"cross-env PORT=3001 node server/src/index.js\" \"wait-on tcp:8443 tcp:3001 && cross-env ELECTRON_DEV_URL=http://localhost:8443 electron .\"",
    "desktop:build": "vite build && electron-builder --publish never",
    "desktop:build:win": "vite build && electron-builder --win --x64 --publish never",
    "desktop:build:mac": "vite build && electron-builder --mac --publish never",
    "desktop:build:mac:universal": "vite build && electron-builder --mac --universal --publish never",
    "qa": "node server/test/qa.mjs --rows=100000 --out=qa-report.md",
    "qa:full": "node --max-old-space-size=3000 server/test/qa.mjs --rows=1000000 --out=qa-report-1M.md",
    "reset-password": "node server/tools/reset-password.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.imprimerie.erp",
    "productName": "Imprimerie ERP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Imprimerie-ERP-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "artifactName": "Imprimerie-ERP-${version}-${arch}.${ext}"
    }
  }
}
